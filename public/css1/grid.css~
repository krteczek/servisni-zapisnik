/* =====================================================
   GRID – pro přehledy (uživatelé, týmy, zakázky...)
   ===================================================== */
.entity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
}

/* Můžeš mít i varianty */
.entity-grid--compact {
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 0.75rem;
}