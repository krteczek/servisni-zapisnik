/* =====================================================
   META DATA – univerzální pro zobrazení informací
   ===================================================== */
.meta-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}
.meta-item {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
}

.meta-label {
    min-width: 0;
    flex: 0 0 auto;
}

.meta-value {
    flex: 1 1 100%;
    color: #222;
}

.member-line {
    padding-left: .5rem;
    border-left: 3px solid transparent;  /* tady ten pásek */
}