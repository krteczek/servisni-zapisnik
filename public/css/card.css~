   ========================= */



.card {
  background: #f3f4f6;
  border: 1px solid #cfd6de;   /* tmavší než dřív */
  border-radius: 10px;
  display: flex;
  flex-direction: column;
}

.card:hover {
  
}

.card-header {
  padding: 16px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #cfd6de;
}
.card-title a {
  font-weight: 600;
  color: #111827;
}

.card-body {
  padding: 16px 18px;
}

.card-footer {
  padding: 14px 18px;
  border-top: 1px solid #cfd6de;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.team-card {
    border-left: 4px solid var(--team-color) !important;
}

.task-card {
    border-left: 4px solid var(--team-color) !important;
}

