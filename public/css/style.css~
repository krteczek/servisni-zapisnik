/* =========================
   RESET / BASE
   ========================= */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  background: #f6f7f9;
  color: #222;
}

/* =========================
   APP LAYOUT (4 ZÓNY)
   ========================= */
.app {
  min-height: 100vh;
  display: grid;
  grid-template-rows: auto 1fr auto;
  grid-template-columns: 240px 1fr;
  grid-template-areas:
    "header header"
    "nav    main"
    "footer footer";
}

/* =========================
   HEADER
   ========================= */
.header {
  grid-area: header;
  background: #fff;
  padding: 12px 16px;
  border-bottom: 1px solid #ccc;
}

.header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
}

.logo {
    width: 72px;
    height: 72px;
    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 40px;
    font-weight: 600;

    background: #8b0000;          /* hluboká červená */
    color: #d4af37;               /* zlatá */
    border: 2px solid #d4af37;

    font-family:
        "Noto Serif SC",
        "Source Han Serif SC",
        serif;

    text-shadow:
        0 1px 0 rgba(255,255,255,.4),
        0 -1px 0 rgba(0,0,0,.3);
}

.logo {
    border-width: 4px;

    box-shadow:
        inset 0 2px 3px rgba(255,255,255,.4),
        inset 0 -2px 3px rgba(0,0,0,.4),
        0 2px 6px rgba(0,0,0,.3);
}
.logo {
    line-height: 1;
    padding-top: 2px;
}

.logo {
    background:
        radial-gradient(circle at 30% 30%,
            #9b0000,
            #6e0000 70%);
}
.user-info {
    display: flex;
    align-items: center;

    height: 72px;
    padding-left: 16px;

    font-size: 13px;
    color: #666;
}

.role-switcher {
    margin-top: 8px;
}

/* =================================
přepínač pohledu rolí pro admina
====================================*/
.role-switcher-label {
    display: block;
    margin-bottom: 6px;
    opacity: .6;
}

.role-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.role-switch a {
    padding: 4px 10px;
    border: 1px solid #ccc;
    border-radius: 3px;
    font-size: 13px;
    text-decoration: none;
    color: #333;
    background: #f8f8f8;
}

.role-switch a:hover {
    background: #eee;
}

.role-switch a.active {
    background: #fff;
    border-color: #000;
    font-weight: 600;
}


/* =========================
   NAV (MENU)
   ========================= */
.nav {
  grid-area: nav;
  background: #dcdcdc;
  padding: 12px 0;
}

/* =========================
   MAIN MENU
   ========================= */
.menu {
  list-style: none;
}

.menu-item {
  background: #cfcfcf;
  border-top: 1px solid #bbb;
}

.menu-item > a {
  display: block;
  padding: 14px 18px;
  text-decoration: none;
  color: #000;
  font-weight: 600;
}

/* hover */
.menu-item:hover {
  background: #bfbfbf;
}

/* =========================
   ACTIVE STATES
   ========================= */

/* aktivní BEZ submenu = bílý list */
.menu-item.active.no-submenu {
  background: #fff;
}

/* aktivní SE submenu = zůstává šedý */
.menu-item.active.has-submenu {
  background: #cfcfcf;
}

/* =========================
   SUBMENU
   ========================= */
.submenu {
  list-style: none;
  background: #dcdcdc;
  padding: 8px 0 12px 16px;
}

/* položky submenu */
.submenu-item a {
  display: block;
  padding: 10px 14px;
  margin-bottom: 4px;
  background: #e6e6e6;
  border: 1px solid #bbb;
  border-left: 4px solid transparent;
  text-decoration: none;
  color: #000;
  font-size: 14px;
}

/* hover submenu */
.submenu-item a:hover {
  background: #d0d0d0;
}

/* aktivní submenu = skutečný list */
.submenu-item.active a {
  background: #fff;
  border-left-color: #999;
}

/* =========================
   MAIN CONTENT
   ========================= */
.main {
  grid-area: main;
  background: #fff;
  padding: 20px;
}

/* =========================
   FOOTER
   ========================= */
.footer {
  grid-area: footer;
  background: #f0f0f0;
  padding: 10px 16px;
  font-size: 13px;
  opacity: .7;
  border-top: 1px solid #ccc;
}


.identity {
    text-align: center;
    line-height: 1.2;
    max-width: 100%;
}

.identity-company {
    font-weight: 600;
    font-size: 0.9rem;
}

.identity-user {
    border-top: 1px solid #ddd;
    margin-top: 4px;
    padding-top: 4px;
}

.identity-role {
    border-top: 1px solid #eee;
    margin-top: 4px;
    padding-top: 4px;
    font-size: 0.8rem;
    color: #666;
}
/* =====================================================
   UI ALERT
   ===================================================== */

.ui-alert {
    margin: 1rem 0;
    padding: .85rem 1rem;
    border-radius: 6px;
    font-size: .9rem;
    line-height: 1.4;
}

.ui-alert-warning {
    background: #fff8e1;
    border: 1px solid #f0c36d;
    border-left: 4px solid #f9a825;
    color: #6d4c00;
}



/* =========================
   RESPONSIVE – MOBILE
   ========================= */
@media (max-width: 768px) {

  .app {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      "header"
      "nav"
      "main"
      "footer";
  }

  .nav {
    padding: 8px 0;
    border-bottom: 1px solid #bbb;
  }

  /* menu přes celou šířku */
  .menu-item > a {
    padding: 14px 16px;
  }

  /* submenu víc odsazené, ať je jasná hierarchie */
  .submenu {
    padding-left: 24px;
  }

}


.flash-wrapper {
    width: 100%;
}

.flash {
    position: relative;
    padding: 16px 20px;
    font-weight: 500;
    border-bottom: 1px solid rgba(0,0,0,0.06);
}

.flash-success {
    background: #e6f9f0;
    color: #1e7e4f;
}

.flash-error {
    background: #fdecea;
    color: #a71d2a;
}

.flash-info {
    background: #e8f4fd;
    color: #0c5460;
}

.flash-close {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    border: none;
    background: none;
    font-size: 18px;
    cursor: pointer;
    opacity: 0.5;
}

.flash-close:hover {
    opacity: 1;
}

