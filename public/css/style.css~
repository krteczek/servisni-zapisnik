/* =========================================================
   RESET + ZÁKLAD
   ========================================================= */

*,
*::before,
*::after {
    box-sizing: border-box;
}
html {
    overflow-y: scroll;
}

body {
    margin: 0;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
    background: #f6f7f9;
    color: #1f2933;
    line-height: 1.5;
}

/* =========================================================
   HEADER
   ========================================================= */

header {
    padding: 12px;
    background: #e9eaed; /* celý navigační pás */
    border-bottom: 1px solid #d1d5db;
}

/* =========================================================
   HLAVNÍ MENU
   ========================================================= */

.menu {
    list-style: none;
    padding: 8px;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 8px;
    background: #e9eaed;
    border-radius: 12px 12px 0 0;
}

.menu-item {
    position: relative;
}

.menu-item a,
.menu-item button {
    all: unset;
    display: block;
    padding: 14px 12px;
    text-align: center;
    background: #dfe1e5; /* neaktivní šedá */
    border: 1px solid #c7c9ce;
    border-radius: 10px 10px 0 0;
    font-weight: 600;
    cursor: pointer;
    color: #1f2933;
}

/* aktivní karta – bez změny rozměrů */
.menu-item.active a,
.menu-item.active button {
    background: #ffffff;
    color: #000;
    border-color: #c7c9ce;
}

/* =========================================================
   SUBMENU – SOUČÁST ŠEDÉHO BLOKU
   ========================================================= */

.submenu {
    list-style: none;
    margin: 0;
    padding: 8px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 8px;
    background: #e9eaed;
}

.submenu-item a {
    display: block;
    padding: 10px 12px;
    text-align: center;
    background: #dfe1e5; /* neaktivní = šedá */
    border: 1px solid #c7c9ce;
    border-radius: 0;
    font-size: 14px;
    color: #374151;
}

/* aktivní submenu = bílá, navazuje na stránku */
.submenu-item.active a {
    background: #ffffff;
    color: #000;
    font-weight: 600;
}

/* =========================================================
   FLASH ZPRÁVY
   ========================================================= */

.flash {
    margin: 8px 0;
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 14px;
}

.flash-success {
    background: #e6f6ec;
}

.flash-error {
    background: #fdeaea;
}

/* =========================================================
   USER INFO
   ========================================================= */

.user-info {
    font-size: 13px;
    opacity: 0.75;
    margin-top: 6px;
}

/* =========================================================
   NADPIS STRÁNKY
   ========================================================= */

h1 {
    margin: 16px 12px;
    font-size: 1.4rem;
}
