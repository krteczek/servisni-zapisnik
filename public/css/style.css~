.menu,
.submenu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 8px;
}
.menu {
    margin-bottom: 14px;
}

.menu-item {
    width: 180px;
}

.menu-item a {
    display: block;
    padding: 12px 16px;
    text-align: center;

    background: #f2f2f2;
    border: 1px solid #ccc;
    border-radius: 6px;

    font-size: 15px;
    font-weight: 600;
    color: #333;
    text-decoration: none;

    transition: background .15s, box-shadow .15s;
}

.menu-item a:hover {
    background: #e9e9e9;
}

.menu-item.active a {
    background: #ffffff;
    border-color: #888;
    box-shadow: 0 2px 6px rgba(0,0,0,.15);
}


.submenu {
    margin-bottom: 20px;
}

.submenu-item {
    width: 160px;
}

.submenu-item a {
    display: block;
    padding: 8px 12px;
    text-align: center;

    background: #fafafa;
    border: 1px solid #ddd;
    border-radius: 5px;

    font-size: 14px;
    font-weight: 500;
    color: #444;
    text-decoration: none;
}

.submenu-item a:hover {
    background: #f0f0f0;
}

.submenu-item.active a {
    background: #e8e8e8;
    border-color: #999;
}

.menu-item.active a {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.submenu {
    margin-top: -1px;
}

.menu-link {
    all: unset;
    display: block;
    width: 100%;
    padding: 12px 16px;
    text-align: center;
    cursor: pointer;
    font: inherit;
}

.menu-item form {
    margin: 0;
}

.menu-item button {
    width: 100%;
    padding: 12px 16px;
    background: #f2f2f2;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
}

.menu-item.active button {
    background: #ffffff;
    border-color: #888;
    box-shadow: 0 2px 6px rgba(0,0,0,.15);
}


.audit-json {
    max-width: 700px;
    max-height: 300px;
    overflow: auto;

    white-space: pre-wrap;
    word-break: break-word;

    background: #f8f9fa;
    padding: 8px;
    border-radius: 4px;
    font-size: 12px;
}


.audit-diff {
    border-collapse: collapse;
    width: 100%;
    margin-top: 10px;
}

.audit-diff th,
.audit-diff td {
    border: 1px solid #ddd;
    padding: 6px 8px;
}

.audit-diff th {
    background: #f5f5f5;
    text-align: left;
}

.audit-diff td.old {
    color: #a00;
    background: #fff5f5;
}

.audit-diff td.new {
    color: #060;
    background: #f5fff5;
}