/* =========================
   RESET / BASE
   ========================= */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  background: #f6f7f9;
  color: #222;
}

/* =========================
   APP LAYOUT (4 ZÓNY)
   ========================= */
.app {
  min-height: 100vh;
  display: grid;
  grid-template-rows: auto 1fr auto;
  grid-template-columns: 240px 1fr;
  grid-template-areas:
    "header header"
    "nav    main"
    "footer footer";
}

/* =========================
   HEADER
   ========================= */
.header {
  grid-area: header;
  background: #fff;
  padding: 12px 16px;
  border-bottom: 1px solid #ccc;
}


.role-switcher {
    margin-top: 8px;
}
/* =================================
přepínač pohledu rolí pro admina
====================================*/
.role-switcher-label {
    display: block;
    margin-bottom: 6px;
    opacity: .6;
}

.role-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.role-switch a {
    padding: 4px 10px;
    border: 1px solid #ccc;
    border-radius: 3px;
    font-size: 13px;
    text-decoration: none;
    color: #333;
    background: #f8f8f8;
}

.role-switch a:hover {
    background: #eee;
}

.role-switch a.active {
    background: #fff;
    border-color: #000;
    font-weight: 600;
}


/* =========================
   NAV (MENU)
   ========================= */
.nav {
  grid-area: nav;
  background: #dcdcdc;
  padding: 12px 0;
}

/* =========================
   MAIN MENU
   ========================= */
.menu {
  list-style: none;
}

.menu-item {
  background: #cfcfcf;
  border-top: 1px solid #bbb;
}

.menu-item > a {
  display: block;
  padding: 14px 18px;
  text-decoration: none;
  color: #000;
  font-weight: 600;
}

/* hover */
.menu-item:hover {
  background: #bfbfbf;
}

/* =========================
   ACTIVE STATES
   ========================= */

/* aktivní BEZ submenu = bílý list */
.menu-item.active.no-submenu {
  background: #fff;
}

/* aktivní SE submenu = zůstává šedý */
.menu-item.active.has-submenu {
  background: #cfcfcf;
}

/* =========================
   SUBMENU
   ========================= */
.submenu {
  list-style: none;
  background: #dcdcdc;
  padding: 8px 0 12px 16px;
}

/* položky submenu */
.submenu-item a {
  display: block;
  padding: 10px 14px;
  margin-bottom: 4px;
  background: #e6e6e6;
  border: 1px solid #bbb;
  border-left: 4px solid transparent;
  text-decoration: none;
  color: #000;
  font-size: 14px;
}

/* hover submenu */
.submenu-item a:hover {
  background: #d0d0d0;
}

/* aktivní submenu = skutečný list */
.submenu-item.active a {
  background: #fff;
  border-left-color: #999;
}

/* =========================
   MAIN CONTENT
   ========================= */
.main {
  grid-area: main;
  background: #fff;
  padding: 20px;
}

/* =========================
   FOOTER
   ========================= */
.footer {
  grid-area: footer;
  background: #f0f0f0;
  padding: 10px 16px;
  font-size: 13px;
  opacity: .7;
  border-top: 1px solid #ccc;
}

/* =========================
   RESPONSIVE – MOBILE
   ========================= */
@media (max-width: 768px) {

  .app {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      "header"
      "nav"
      "main"
      "footer";
  }

  .nav {
    padding: 8px 0;
    border-bottom: 1px solid #bbb;
  }

  /* menu přes celou šířku */
  .menu-item > a {
    padding: 14px 16px;
  }

  /* submenu víc odsazené, ať je jasná hierarchie */
  .submenu {
    padding-left: 24px;
  }

}
