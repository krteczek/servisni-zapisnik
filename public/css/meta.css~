.meta-label {
  font-size: 0.75rem;
  font-weight: 600;
  color: #4b5563;
  letter-spacing: 0.02em;
  white-space: nowrap;
  width: 120px;
  flex-shrink: 0;

}

.meta-value {
  font-size: 0.85rem;
  font-weight: 400;
  color: #111827; /* skoro černá */
  line-height: 1.4;
border-bottom: 1px solid #e5e7eb;
}
.meta-item {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;

  margin-bottom: 0,5rem;
  padding-left: 0.75rem;
  border-left: 2px solid #e5e7eb;
  border-bottom: 1px solid #e5e7eb;
}

.meta-label-header {
  font-size: 0.8rem;
  color: #374151;
}

